{
  "name": "ww-dps-sim",
  "version": "0.0.0",
  "private": true,
  "description": "鸣潮逐帧期望 DPS 仿真与配装择优工具",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build:data": "python3 tools/build/build_data.py",
    "check": "tsc -p tsconfig.json",
    "check:data": "tsx src/data/check-generated.ts",
    "test": "vitest run",
    "test:py": "python3 -m unittest discover -s tools/build -p 'test_*.py'"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
