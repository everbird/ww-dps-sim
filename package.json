{
  "name": "ww-dps-sim",
  "version": "0.0.0",
  "private": true,
  "description": "鸣潮逐帧期望 DPS 仿真与配装择优工具",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:data": "python3 tools/build/build_data.py",
    "check": "tsc -p tsconfig.json && svelte-check --tsconfig web/app/tsconfig.json --threshold error",
    "check:data": "tsx src/data/check-generated.ts",
    "golden:perturb": "python3 tools/build/golden_perturb.py",
    "sim": "tsx src/cli/sim.ts",
    "compare": "tsx src/cli/compare.ts",
    "marginal": "tsx src/cli/marginal.ts",
    "timeline": "tsx src/cli/timeline.ts",
    "test": "vitest run",
    "test:py": "python3 -m unittest discover -s tools/build -p 'test_*.py'",
    "trace": "tsx src/cli/trace.ts",
    "optimize": "tsx src/cli/optimize.ts",
    "web": "vite web/app",
    "web:build": "vite build web/app",
    "check:web": "svelte-check --tsconfig web/app/tsconfig.json"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
